{
    "name": "dsaintdenis/fizzbuzz",
    "description": "FizzBuzz kata - Fulll hiring test",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "FizzBuzz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FizzBuzz\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    }
}
