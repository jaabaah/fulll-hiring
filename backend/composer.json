{
    "name": "dsaintdenis/fleet",
    "description": "Vehicle fleet parking management - Fulll hiring test",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/console": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Fulll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fulll\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
