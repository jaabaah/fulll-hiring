{
    "name": "dsaintdenis/fleet",
    "description": "Vehicle fleet parking management - Fulll hiring test",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo_pgsql": "*",
        "symfony/console": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Fulll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fulll\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "deptrac/deptrac": "^4.7"
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress",
        "deptrac": "deptrac analyse --no-progress --fail-on-uncovered",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "behat": "behat",
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "@cs",
            "@phpstan",
            "@deptrac",
            "@test:unit",
            "@test:integration",
            "@behat"
        ]
    }
}
