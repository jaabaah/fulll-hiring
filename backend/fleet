#!/usr/bin/env php
<?php

declare(strict_types=1);

use Fulll\Infra\Cli\FleetApplication;
use Fulll\Infra\Postgres\PdoFactory;
use Fulll\Infra\Postgres\PostgresFleetRepository;

require __DIR__ . '/vendor/autoload.php';

// Lazy proxy: the database is only reached when a command uses the repository, so `--help` or `list` work without it,
// and a configuration or connection problem is reported like any other error of the command, with exit code 1.
$fleets = new ReflectionClass(PostgresFleetRepository::class)->newLazyProxy(
    static function (): PostgresFleetRepository {
        // Defaults to the database started by compose.yaml.
        $databaseUrl = getenv('DATABASE_URL') ?: 'postgresql://fleet:fleet@127.0.0.1:5442/fleet';

        try {
            return new PostgresFleetRepository(PdoFactory::fromUrl($databaseUrl));
        } catch (PDOException $error) {
            throw new RuntimeException(
                sprintf('Cannot connect to the database (is it started? docker compose up -d): %s', $error->getMessage()),
                previous: $error,
            );
        }
    },
);

exit(FleetApplication::create($fleets)->run());
